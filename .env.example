# Sao chép thành .env trên VPS và thay toàn bộ giá trị placeholder.
# Không commit .env, không gửi khóa qua chat/ticket, và không dùng lại mật khẩu mẫu này.

DOMAIN=tickets.example.com
APP_URL=https://tickets.example.com

# Tạo riêng trên VPS, ví dụ: openssl rand -base64 36
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
# Mật khẩu trong URL phải được percent-encode nếu chứa ký tự đặc biệt.
DATABASE_URL=postgresql://ticketops:REPLACE_WITH_URL_ENCODED_PASSWORD@postgres:5432/ticketops

# Để trống chỉ cho staging chưa thanh toán; ứng dụng phải từ chối tạo link thật khi thiếu khóa.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
